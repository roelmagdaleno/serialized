{
    "name": "roelmagdaleno/serialized",
    "description": "Convert PHP serialized data into pretty-printed JSON, safely.",
    "license": "MIT",
    "keywords": [
        "json",
        "serialized",
        "unserialize"
    ],
    "authors": [
        {
            "name": "Roel Magdaleno",
            "email": "roelmagdaleno@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "pestphp/pest": "^5.2",
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Serialized\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest",
        "pint": "./vendor/bin/pint",
        "stan": "./vendor/bin/phpstan analyse",
        "check": [
            "@pint --test",
            "@stan",
            "@test"
        ],
        "coverage": "php -d zend_extension=/Applications/Herd.app/Contents/Resources/xdebug/xdebug-84-arm64.so -d xdebug.mode=coverage ./vendor/bin/pest --coverage --min=100"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
